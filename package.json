{
  "name": "ai-group-whisper",
  "productName": "AI Group Whisper",
  "version": "1.1.0",
  "description": "Standalone macOS app: watches Telegram groups, summarizes and drafts AI replies, stores everything locally in SQLite.",
  "main": "electron/main.cjs",
  "license": "MIT",
  "repository": "github:alpharomeo99/ai-group-whisper-mac",
  "scripts": {
    "start": "electron .",
    "setup:python": "bash scripts/setup-python.sh",
    "package:mac": "electron-packager . \"AI Group Whisper\" --platform=darwin --arch=arm64,x64 --out=release --overwrite --ignore=^/release --ignore=^/daemon/.venv"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "@electron/packager": "^18.3.0"
  }
}
